{
    "name": "@flippo-software/biome",
    "version": "1.1.1",
    "type": "module",
    "exports": {
        "base": {
            "default": "./src/configs/base.config.jsonc"
        },
        "react": {
            "default": "./src/configs/react.config.jsonc"
        },
        "storybook": {
            "default": "./src/configs/storybook.config.jsonc"
        },
        "test": {
            "default": "./src/configs/test.config.jsonc"
        }
    },
    "files": [
        "src"
    ],
    "scripts": {
        "prepare": "simple-git-hooks",
        "lint": "biome lint",
        "format": "biome format --write",
        "check": "biome ci .",
        "hooks:install": "simple-git-hooks"
    },
    "simple-git-hooks": {
        "pre-commit": "test \"$(git symbolic-ref --quiet HEAD)\" != refs/heads/main || { echo \"Direct commits to main are not allowed. Create a feature branch.\" >&2; exit 1; }",
        "pre-push": "while read -r local_ref local_sha remote_ref remote_sha; do if [ \"$remote_ref\" = refs/heads/main ]; then echo \"Direct pushes to main are not allowed. Open a pull request.\" >&2; exit 1; fi; done",
        "pre-merge-commit": "test \"$(git symbolic-ref --quiet HEAD)\" != refs/heads/main || { echo \"Local merge commits on main are not allowed. Open a pull request.\" >&2; exit 1; }",
        "preserveUnused": true
    },
    "keywords": [],
    "author": "BlackPoretsky (Egor Gorochkin)",
    "license": "ISC",
    "packageManager": "pnpm@11.24.0",
    "peerDependencies": {
        "@biomejs/biome": "^2.5.11"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.11",
        "simple-git-hooks": "^2.14.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/FlippoSoftware/biome.git"
    },
    "homepage": "https://github.com/FlippoSoftware/biome#readme",
    "bugs": {
        "url": "https://github.com/FlippoSoftware/biome/issues"
    }
}
