{
    "name": "@flippo-software/biome",
    "version": "1.1.0",
    "type": "module",
    "exports": {
        "base": {
            "default": "./src/configs/base.config.jsonc"
        },
        "react": {
            "default": "./src/configs/react.config.jsonc"
        },
        "storybook": {
            "default": "./src/configs/storybook.config.jsonc"
        },
        "test": {
            "default": "./src/configs/test.config.jsonc"
        }
    },
    "files": [
        "src"
    ],
    "scripts": {
        "prepare": "simple-git-hooks",
        "lint": "biome lint",
        "format": "biome format --write",
        "check": "biome ci ."
    },
    "simple-git-hooks": {
        "pre-commit": "test \"$(git symbolic-ref --short HEAD)\" != main || { echo '✖ Direct commits to main are not allowed — create a feature branch.' >&2; exit 1; }",
        "pre-push": "while read local_ref local_sha remote_ref remote_sha; do case \"$remote_ref\" in refs/heads/main) echo '✖ Direct pushes to main are not allowed — open a pull request.' >&2; exit 1;; esac; done"
    },
    "keywords": [],
    "author": "BlackPoretsky (Egor Gorochkin)",
    "license": "ISC",
    "packageManager": "pnpm@11.24.0",
    "peerDependencies": {
        "@biomejs/biome": "^2.5.11"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.11",
        "simple-git-hooks": "^2.14.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/FlippoSoftware/biome.git"
    },
    "homepage": "https://github.com/FlippoSoftware/biome#readme",
    "bugs": {
        "url": "https://github.com/FlippoSoftware/biome/issues"
    }
}
